templates:
  - templates/postgres.template.yml
  - templates/redis.template.yml
  - templates/web.template.yml
  - templates/web.ratelimited.template.yml
  - templates/web.ssl.template.yml
  - templates/web.letsencrypt.ssl.template.yml
expose:
  - 80:80
  - 443:443
params:
  db_default_text_search_config: pg_catalog.english
  db_shared_buffers: 1024MB
env:
  LC_ALL: "{{ LANGUAGE }}"
  LANG: "{{ LANGUAGE }}"
  LANGUAGE: "{{ LANGUAGE }}"
  DISCOURSE_HOSTNAME: "{{ DISCOURSE_FQDN }}"
  DISCOURSE_DEVELOPER_EMAILS: "{{ SMTP_RECIPIENT }}"
  DISCOURSE_SMTP_ADDRESS: "{{ SMTP_HOST }}"
  DISCOURSE_SMTP_USER_NAME: "{{ DISCOURSE_NOTIFICATION_EMAIL }}"
  DISCOURSE_SMTP_PASSWORD: "{{ SMTP_PASSWORD_FORUM }}"
  DISCOURSE_SMTP_PORT: "{{ SMTP_PORT }}"
  DISCOURSE_NOTIFICATION_EMAIL: "{{ DISCOURSE_NOTIFICATION_EMAIL }}"
  DISCOURSE_SMTP_DOMAIN: "{{ SMTP_DOMAIN }}"
  DISCOURSE_SMTP_FORCE_TLS: true
  UNICORN_WORKERS: 4
volumes:
  - volume:
      host: "{{ DISCOURSE_INSTALL_DIR }}/shared/standalone"
      guest: "/shared"
  - volume:
      host: "{{ DISCOURSE_INSTALL_DIR }}/shared/standalone/log/var-log"
      guest: "/var/log"
hooks:
  after_code:
    - exec:
        cd: "$home/plugins"
        cmd:
          - git clone https://github.com/discourse/docker_manager.git
run:
  - exec: echo "Beginning of custom commands"
  - exec: echo "End of custom commands"
